<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 本机和局域网模型地址由用户填写，允许明文 HTTP；HTTPS 仍仅信任系统 CA。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
